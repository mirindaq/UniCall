        <!-- ==================== AUTH FLOW NOTE ==================== -->
        <mxCell id="auth_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;fontSize=10;" value="&lt;b&gt;Authentication Flow:&lt;/b&gt;&lt;br&gt;1. Client sends request with JWT in Authorization header&lt;br&gt;2. API Gateway validates JWT signature (Keycloak public key)&lt;br&gt;3. Gateway checks token expiration&lt;br&gt;4. If valid → forwards request to target service&lt;br&gt;5. If invalid → returns 401 Unauthorized&lt;br&gt;&lt;br&gt;&lt;b&gt;Inter-Service Communication:&lt;/b&gt;&lt;br&gt;- Services communicate via gRPC (fast binary protocol)&lt;br&gt;- Contracts defined in proto-common module&lt;br&gt;- Async events via RabbitMQ (notifications)" vertex="1">
